# ─────────────────────────────────────────────────────────────────────────────
# QuantiText Production Environment Template (.env)
# Copy to .env on your production server: cp .env.production.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="QuantiText"
DEBUG=false
API_PREFIX="/api/v1"

# ─── Security / Auth ─────────────────────────────────────────────────────────
# Generate a 64-char random key with: openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
CORS_ORIGINS=https://your-domain.com

# ─── PostgreSQL (In-Compose Container) ───────────────────────────────────────
POSTGRES_USER=quantitext
# Set a strong random password for postgres superuser
POSTGRES_PASSWORD=set_strong_production_postgres_password
POSTGRES_DB=quantitext
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://quantitext:set_strong_production_postgres_password@postgres:5432/quantitext
DATABASE_URL_SYNC=postgresql+psycopg2://quantitext:set_strong_production_postgres_password@postgres:5432/quantitext

# Read-only user for secure NL2SQL queries:
# Configure after initial migration with:
# docker compose -f docker-compose.prod.yml exec postgres psql -U quantitext -d quantitext -c "ALTER ROLE bi_readonly LOGIN PASSWORD 'bi_readonly_secure_password';"
DB_READONLY_URL=postgresql+asyncpg://bi_readonly:bi_readonly_secure_password@postgres:5432/quantitext

# ─── Redis (In-Compose Container) ────────────────────────────────────────────
REDIS_PASSWORD=set_strong_production_redis_password
REDIS_URL=redis://:set_strong_production_redis_password@redis:6379/0

# ─── LLM Provider (Google Gemini) ───────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
LLM_MODEL=gemini-3.5-flash

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── MLflow ──────────────────────────────────────────────────────────────────
# Local file tracking storage inside the container
MLFLOW_TRACKING_URI=file:/tmp/mlruns
