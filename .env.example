# ─── App ───────────────────────────────────────────────
APP_NAME="QuantiText"
DEBUG=true
API_PREFIX="/api/v1"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=quantitext
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=quantitext
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quantitext:changeme_dev_only@postgres:5432/quantitext
DATABASE_URL_SYNC=postgresql+psycopg2://quantitext:changeme_dev_only@postgres:5432/quantitext
DB_READONLY_URL=postgresql+asyncpg://quantitext:changeme_dev_only@postgres:5432/quantitext

# ─── Redis ─────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ─── Auth ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── LLM Provider ──────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# ─── Ollama (local LLM fallback) ───────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
OLLAMA_TEXT_MODEL=llama3:8b

# ─── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=file:/tmp/mlruns
