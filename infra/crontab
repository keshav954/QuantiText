# QuantiText Production Crontab
# Install with: crontab infra/crontab
# Logs are routed to /var/log/quantitext/

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 1. Daily automated database backup (02:00 UTC)
0 2 * * * /opt/quantitext/infra/backup.sh >> /var/log/quantitext_backup.log 2>&1

# 2. Weekly LightGBM forecast model retrain (Sundays at 03:00 UTC)
0 3 * * 0 docker compose -f /opt/quantitext/docker-compose.prod.yml exec -T backend python -m app.jobs.retrain >> /var/log/quantitext_retrain.log 2>&1
