# Auto detect text files and perform LF normalization on checkout and commit
* text=auto eol=lf

# Shell scripts must strictly use LF
*.sh text eol=lf
*.bash text eol=lf

# Python, TypeScript, JSON, YAML
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.conf text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.parquet binary
